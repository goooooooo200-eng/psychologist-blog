collections:
  - name: "posts"
    label: "Посты"
    folder: "posts"
    create: true
    slug: "{{year}}-{{month}}-{{day}}-{{slug}}"
    fields:
      - {label: "Заголовок", name: "title", widget: "string"}
      - {label: "Дата", name: "date", widget: "datetime"}
      - {label: "Изображение", name: "image", widget: "image", required: false}
      - {label: "Текст", name: "body", widget: "markdown"}
    # Дополнительно: после сохранения поста обновлять список в отдельном JSON-файле
    # Но Decap CMS не умеет автоматически писать в другой файл. Придётся использовать хуки или сторонние сервисы.

  # Альтернатива: хранить все посты в одном JSON-файле
  - name: "allPosts"
    label: "Все посты (JSON)"
    files:
      - name: "posts"
        label: "Посты"
        file: "posts.json"
        fields:
          - label: "Список постов"
            name: "posts"
            widget: "list"
            fields:
              - {label: "Заголовок", name: "title", widget: "string"}
              - {label: "Дата", name: "date", widget: "datetime"}
              - {label: "Изображение", name: "image", widget: "image", required: false}
              - {label: "Содержание", name: "body", widget: "markdown"}
